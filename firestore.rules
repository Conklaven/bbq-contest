rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.isAdmin == true;
    }
    
    function isJudge() {
      return isAuthenticated() && !isTeam() && (request.auth.token.isJudge == true || exists(/databases/$(database)/documents/judges/$(request.auth.uid)));
    }
    
    function isTeam() {
      return isAuthenticated() && request.auth.token.isTeam == true;
    }
    
    function isTeamMember(teamId) {
      return isAuthenticated() && request.auth.token.teamId == teamId;
    }
    
    // Teams collection
    match /teams/{teamId} {
      allow read: if isAdmin() || isTeamMember(teamId);
      allow write: if isAdmin();
    }
    
    // Items collection - allow any authenticated user (including anonymous judges) to read items
    match /items/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Judges collection
    match /judges/{judgeId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == judgeId);
      allow write: if isAdmin() || (!isTeam() && isAuthenticated() && request.auth.uid == judgeId);
    }
    
    // Scores collection
    match /scores/{scoreId} {
      allow read: if isAdmin() || 
                   (isAuthenticated() && request.auth.uid == resource.data.judgeId) ||
                   (isTeam() && exists(/databases/$(database)/documents/items/$(resource.data.itemId)) && 
                    get(/databases/$(database)/documents/items/$(resource.data.itemId)).data.teamId == request.auth.token.teamId);
      allow create: if !isTeam() && (isAdmin() || (isAuthenticated() && request.auth.uid == request.resource.data.judgeId && isJudge()));
      allow update: if !isTeam() && (isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.judgeId));
      allow delete: if isAdmin();
    }
    
    // Settings collection
    match /settings/{settingId} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAdmin();
    }
  }
}